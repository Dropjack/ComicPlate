<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:ComicPlate.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:ComicPlate.App.Views"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="800"
        x:Class="ComicPlate.App.MainWindow"
        Title="{Binding WindowTitle}"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="620"
        Background="{StaticResource BackgroundBase}"
        KeyDown="OnKeyDown"
        KeyUp="OnKeyUp"
        PointerWheelChanged="OnPointerWheelChanged">

    <Window.Resources>
        <StreamGeometry x:Key="OpenBookIcon">M4 5.5 C6.7 4.9 9.2 5.4 12 7.1 L12 19.1 C9.2 17.4 6.7 16.9 4 17.5 Z M12 7.1 C14.8 5.4 17.3 4.9 20 5.5 L20 17.5 C17.3 16.9 14.8 17.4 12 19.1 Z M7 9.2 L9.4 9.2 M7 12 L9.1 12 M15.2 9.4 C16.1 9.1 17 8.9 18 8.9</StreamGeometry>
        <StreamGeometry x:Key="OpenFolderIcon">M4.5 7 L10 7 L11.4 8.8 L19.5 8.8 L19.5 17.5 L4.5 17.5 Z M4.5 9.6 L19.5 9.6</StreamGeometry>
        <StreamGeometry x:Key="NewWindowIcon">M5 6 L15.5 6 L15.5 16.5 L5 16.5 Z M8.5 9.5 L12 9.5 M10.25 7.75 L10.25 11.25 M8.5 19 L19 19 L19 8.5</StreamGeometry>
        <StreamGeometry x:Key="ShelfHideIcon">M4 5 L20 5 L20 19 L4 19 Z M8.5 5 L8.5 19 M16 12 L10.8 12 M13 9.2 L10.2 12 L13 14.8</StreamGeometry>
        <StreamGeometry x:Key="ShelfShowIcon">M4 5 L20 5 L20 19 L4 19 Z M7 5 L7 19 M8.5 12 L13.7 12 M11.5 9.2 L14.3 12 L11.5 14.8</StreamGeometry>
        <StreamGeometry x:Key="SinglePageIcon">M7.5 4 L16.5 4 L16.5 20 L7.5 20 Z M10.2 7.5 L13.8 7.5 M10.2 10.2 L13.3 10.2</StreamGeometry>
        <StreamGeometry x:Key="DoublePageIcon">M4.5 5 L11.5 5 L11.5 19 L4.5 19 Z M12.5 5 L19.5 5 L19.5 19 L12.5 19 Z M12 6.5 L12 17.5</StreamGeometry>
        <StreamGeometry x:Key="ReadLtrIcon">M4.5 5 L11.3 5 L11.3 19 L4.5 19 Z M12.7 5 L19.5 5 L19.5 19 L12.7 19 Z M7.2 12 L16 12 M13.6 9.6 L16 12 L13.6 14.4</StreamGeometry>
        <StreamGeometry x:Key="ReadRtlIcon">M4.5 5 L11.3 5 L11.3 19 L4.5 19 Z M12.7 5 L19.5 5 L19.5 19 L12.7 19 Z M16.8 12 L8 12 M10.4 9.6 L8 12 L10.4 14.4</StreamGeometry>
        <StreamGeometry x:Key="UserSettingsIcon">M5 8 L19 8 M5 16 L19 16 M7 8 A2 2 0 1 0 11 8 A2 2 0 1 0 7 8 M13 16 A2 2 0 1 0 17 16 A2 2 0 1 0 13 16</StreamGeometry>
        <StreamGeometry x:Key="NavLeftIcon">M15.5 5.2 L7.5 12 L15.5 18.8 M16.5 6.5 C15.3 9.9 15.3 14.1 16.5 17.5 M8.5 12 L16.5 12</StreamGeometry>
        <StreamGeometry x:Key="NavRightIcon">M8.5 5.2 L16.5 12 L8.5 18.8 M7.5 6.5 C8.7 9.9 8.7 14.1 7.5 17.5 M15.5 12 L7.5 12</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Window.mac-shell">
            <Setter Property="Background" Value="{StaticResource BackgroundBase}" />
        </Style>

        <Style Selector="Window.mac-shell Grid.main-shell">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Window.windows-shell Grid.main-shell">
            <Setter Property="Background" Value="{StaticResource BackgroundBase}" />
        </Style>

        <Style Selector="Window.mac-shell Border.left-floating-panel">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="30" />
            <Setter Property="Margin" Value="10,48,0,10" />
        </Style>

        <Style Selector="Window.mac-shell Border.left-floating-panel.shelf-open">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource MacSidebarGlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="10,48,0,10" />
            <Setter Property="BoxShadow" Value="0 18 46 0 #30000000, inset 0 1 0 0 #F2FFFFFF" />
        </Style>

        <Style Selector="Window.windows-shell Border.left-floating-panel">
            <Setter Property="Background" Value="{StaticResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>

        <Style Selector="Window.mac-shell Border.command-rail">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="30,0,0,30" />
        </Style>

        <Style Selector="Window.mac-shell Grid.command-rail-content">
            <Setter Property="Margin" Value="0,12" />
        </Style>

        <Style Selector="Window.windows-shell Grid.command-rail-content">
            <Setter Property="Margin" Value="0,12" />
        </Style>

        <Style Selector="Window.mac-shell TextBlock.app-mark">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="Window.mac-shell Border.reader-title-bar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Window.mac-shell Grid.reader-layout">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Window.mac-shell Grid.reader-stage">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <Style Selector="Window.mac-shell Border.mac-title-bar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Styles>

    <Grid x:Name="MainShell"
          ColumnDefinitions="64,*"
          Classes="main-shell">
        <Border x:Name="MacTitleBar"
                Classes="mac-title-bar"
                Height="32"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                ZIndex="4"
                IsVisible="False"
                PointerPressed="OnMacTitleBarPointerPressed">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                  Background="Transparent"
                  Margin="180,0,18,0">
                <TextBlock Grid.Column="1"
                           Text="{Binding ReaderTitle}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           MaxWidth="520"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Reader.PageText}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3"
                           Text="{Binding Reader.MagnifierScaleText}"
                           IsVisible="{Binding Reader.IsMagnifierActive}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           MinWidth="38"
                           Margin="8,0,0,0"
                           TextAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border x:Name="LeftFloatingPanel"
                Grid.Column="0"
                Classes="left-floating-panel"
                Classes.shelf-open="{Binding IsReaderNavigationPaneVisible}"
                ClipToBounds="True"
                HorizontalAlignment="Left"
                ZIndex="5">
            <Grid ColumnDefinitions="64,Auto,Auto">
                <Border Grid.ColumnSpan="3"
                        Background="{DynamicResource MacSidebarGlassOverlayBrush}"
                        CornerRadius="30"
                        IsHitTestVisible="False"
                        IsVisible="{Binding IsReaderNavigationPaneVisible}" />

                <Border Grid.Column="0"
                        x:Name="CommandRail"
                        Classes="command-rail"
                        Background="Transparent">
                    <Grid RowDefinitions="Auto,*"
                          Classes="command-rail-content">
                        <TextBlock Grid.Row="0"
                                   Classes="app-mark"
                                   Text="CP"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,14" />

                        <StackPanel Grid.Row="1"
                                    Spacing="8"
                                    HorizontalAlignment="Center">
                            <Button Command="{Binding OpenContentCommand}"
                                    Width="52"
                                    MinHeight="44"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="18"
                                    ToolTip.Tip="{loc:Loc Main.OpenComic.Tooltip}">
                                <PathIcon Data="{StaticResource OpenBookIcon}"
                                          Width="24"
                                          Height="24" />
                            </Button>
                            <Button Command="{Binding OpenFolderCommand}"
                                    Width="52"
                                    MinHeight="44"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="18"
                                    ToolTip.Tip="{loc:Loc Main.OpenFolder.Tooltip}">
                                <PathIcon Data="{StaticResource OpenFolderIcon}"
                                          Width="24"
                                          Height="24" />
                            </Button>
                            <Button Click="OnNewWindowClick"
                                    Width="52"
                                    MinHeight="44"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="18"
                                    ToolTip.Tip="{loc:Loc Main.NewWindow.Tooltip}"
                                    IsVisible="{Binding CanCreateNewWindow, RelativeSource={RelativeSource AncestorType=Window}}">
                                <PathIcon Data="{StaticResource NewWindowIcon}"
                                          Width="24"
                                          Height="24" />
                            </Button>
                            <Button Command="{Binding ToggleNavigationPaneCommand}"
                                    Width="52"
                                    MinHeight="44"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="18"
                                    ToolTip.Tip="{Binding NavigationPaneToggleText}"
                                    IsEnabled="{Binding IsNavigationPaneAvailable}"
                                    IsVisible="{Binding IsReaderVisible}">
                                <Grid>
                                    <PathIcon Data="{StaticResource ShelfHideIcon}"
                                              Width="24"
                                              Height="24"
                                              IsVisible="{Binding IsNavigationPaneVisible}" />
                                    <PathIcon Data="{StaticResource ShelfShowIcon}"
                                              Width="24"
                                              Height="24"
                                              IsVisible="{Binding IsNavigationPaneHidden}" />
                                </Grid>
                            </Button>
                            <Button Command="{Binding Reader.ToggleViewModeCommand}"
                                    Width="52"
                                    MinHeight="44"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="18"
                                    ToolTip.Tip="{Binding Reader.ViewModeText}"
                                    IsVisible="{Binding IsReaderVisible}">
                                <Grid>
                                    <PathIcon Data="{StaticResource SinglePageIcon}"
                                              Width="24"
                                              Height="24"
                                              IsVisible="{Binding Reader.IsSinglePageMode}" />
                                    <PathIcon Data="{StaticResource DoublePageIcon}"
                                              Width="24"
                                              Height="24"
                                              IsVisible="{Binding Reader.IsDoublePageMode}" />
                                </Grid>
                            </Button>
                            <Button Command="{Binding Reader.ToggleReadingDirectionCommand}"
                                    Width="52"
                                    MinHeight="44"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="18"
                                    ToolTip.Tip="{Binding Reader.ReadingDirectionText}"
                                    IsVisible="{Binding IsReaderVisible}">
                                <Grid>
                                    <PathIcon Data="{StaticResource ReadLtrIcon}"
                                              Width="24"
                                              Height="24"
                                              IsVisible="{Binding Reader.IsLeftToRightReading}" />
                                    <PathIcon Data="{StaticResource ReadRtlIcon}"
                                              Width="24"
                                              Height="24"
                                              IsVisible="{Binding Reader.IsRightToLeftReading}" />
                                </Grid>
                            </Button>
                            <Button Click="OnSettingsClick"
                                    Width="52"
                                    MinHeight="44"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="18"
                                    ToolTip.Tip="{loc:Loc Main.Settings.Tooltip}"
                                    IsEnabled="True">
                                <PathIcon Data="{StaticResource UserSettingsIcon}"
                                          Width="24"
                                          Height="24" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="MacShelfDivider"
                        Grid.Column="1"
                        Width="1"
                        Background="#55FFFFFF"
                        IsVisible="{Binding IsReaderNavigationPaneVisible}" />

                <views:ContextShelfView x:Name="MacContextShelf"
                                        Grid.Column="2"
                                        Width="300"
                                        MinWidth="220"
                                        IsVisible="{Binding IsReaderNavigationPaneVisible}" />
            </Grid>
        </Border>

        <views:StartView x:Name="StartScreen"
                         Grid.Column="1"
                         IsVisible="{Binding IsStartVisible}" />

        <Grid x:Name="ReaderLayoutGrid"
              Grid.Column="1"
              Classes="reader-layout"
              IsVisible="{Binding IsReaderVisible}"
              ColumnDefinitions="Auto,*">
            <Grid x:Name="WindowsShelfHost"
                  Grid.Column="0">
                <views:ContextShelfView x:Name="WindowsContextShelf"
                                        Width="300"
                                        MinWidth="220"
                                        IsVisible="{Binding IsNavigationPaneVisible}" />
            </Grid>
            <Grid x:Name="ReaderStageGrid"
                  Classes="reader-stage"
                  Grid.Column="1"
                  RowDefinitions="40,*">
                <Border Grid.Row="0"
                        Classes="reader-title-bar"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto"
                          Margin="14,0">
                        <TextBlock Text="{Binding ReaderTitle}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Reader.MagnifierScaleText}"
                                   IsVisible="{Binding Reader.IsMagnifierEnabled}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"
                                   MinWidth="44"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <views:ReaderSurfaceView x:Name="ReaderSurface"
                                         Grid.Row="1" />
            </Grid>
        </Grid>
    </Grid>
</Window>
