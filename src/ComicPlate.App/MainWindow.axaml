<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:ComicPlate.App.Views"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="800"
        x:Class="ComicPlate.App.MainWindow"
        Title="ComicPlate"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="620"
        Background="#F4F4F4"
        KeyDown="OnKeyDown"
        PointerWheelChanged="OnPointerWheelChanged">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FAFAFA" />
        <SolidColorBrush x:Key="SubtlePanelBrush" Color="#F0F0F0" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D8D8D8" />
        <SolidColorBrush x:Key="TextBrush" Color="#1F1F1F" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#666666" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    </Window.Resources>

    <Grid ColumnDefinitions="64,*"
          Background="#F4F4F4">
        <Border Grid.Column="0"
                Background="#ECEFF3"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*"
                  Margin="0,10">
                <TextBlock Grid.Row="0"
                           Text="CP"
                           Foreground="{StaticResource TextBrush}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,14" />

                <StackPanel Grid.Row="1"
                            Spacing="8"
                            HorizontalAlignment="Center">
                    <Button Command="{Binding OpenContentCommand}"
                            Content="Open"
                            Width="52"
                            MinHeight="44"
                            Padding="0"
                            CornerRadius="6"
                            ToolTip.Tip="Open comics" />
                    <Button Command="{Binding ToggleNavigationPaneCommand}"
                            Content="Shelf"
                            Width="52"
                            MinHeight="44"
                            Padding="0"
                            CornerRadius="6"
                            ToolTip.Tip="{Binding NavigationPaneToggleText}"
                            IsVisible="{Binding IsReaderVisible}" />
                    <Button Command="{Binding Reader.ToggleViewModeCommand}"
                            Content="{Binding Reader.ViewModeText}"
                            Width="52"
                            MinHeight="44"
                            Padding="0"
                            CornerRadius="6"
                            ToolTip.Tip="Single / Double page"
                            IsVisible="{Binding IsReaderVisible}" />
                    <Button Command="{Binding Reader.ToggleReadingDirectionCommand}"
                            Content="{Binding Reader.ReadingDirectionText}"
                            Width="52"
                            MinHeight="44"
                            Padding="0"
                            CornerRadius="6"
                            ToolTip.Tip="Reading direction"
                            IsVisible="{Binding IsReaderVisible}" />
                    <Button Content="Set"
                            Width="52"
                            MinHeight="44"
                            Padding="0"
                            CornerRadius="6"
                            ToolTip.Tip="Settings"
                            IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>

        <views:StartView Grid.Column="1"
                         IsVisible="{Binding IsStartVisible}" />

        <Grid Grid.Column="1"
              IsVisible="{Binding IsReaderVisible}"
              ColumnDefinitions="Auto,*">
            <views:ContextShelfView Grid.Column="0"
                                    Width="300"
                                    MinWidth="220"
                                    IsVisible="{Binding IsNavigationPaneVisible}" />
            <Grid Grid.Column="1"
                  RowDefinitions="40,*">
                <Border Grid.Row="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding ReaderTitle}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="14,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Border>
                <views:ReaderSurfaceView Grid.Row="1" />
            </Grid>
        </Grid>
    </Grid>
</Window>
