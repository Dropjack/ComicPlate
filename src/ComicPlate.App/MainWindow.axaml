<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:ComicPlate.App.Views"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="800"
        x:Class="ComicPlate.App.MainWindow"
        Title="ComicPlate"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="620"
        Background="#F4F4F4"
        KeyDown="OnKeyDown"
        PointerWheelChanged="OnPointerWheelChanged">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FAFAFA" />
        <SolidColorBrush x:Key="SubtlePanelBrush" Color="#F0F0F0" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D8D8D8" />
        <SolidColorBrush x:Key="TextBrush" Color="#1F1F1F" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#666666" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    </Window.Resources>

    <Grid RowDefinitions="44,*"
          Background="#F4F4F4">
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto"
                  Margin="10,0"
                  ColumnSpacing="8"
                  VerticalAlignment="Center">
                <Button Grid.Column="0"
                        Command="{Binding ShowStartCommand}"
                        Content="Home"
                        Padding="12,5"
                        CornerRadius="4" />
                <Button Grid.Column="1"
                        Command="{Binding OpenContentCommand}"
                        Content="Open Folder"
                        Padding="12,5"
                        CornerRadius="4" />
                <Button Grid.Column="2"
                        Command="{Binding ToggleNavigationPaneCommand}"
                        Content="{Binding NavigationPaneToggleText}"
                        Padding="12,5"
                        CornerRadius="4"
                        IsVisible="{Binding IsReaderVisible}" />
                <Button Grid.Column="3"
                        Command="{Binding Reader.ToggleViewModeCommand}"
                        Content="{Binding Reader.ViewModeText}"
                        Padding="12,5"
                        CornerRadius="4"
                        IsVisible="{Binding IsReaderVisible}" />
                <Button Grid.Column="4"
                        Command="{Binding Reader.ToggleReadingDirectionCommand}"
                        Content="{Binding Reader.ReadingDirectionText}"
                        Padding="12,5"
                        CornerRadius="4"
                        IsVisible="{Binding IsReaderVisible}" />
                <TextBlock Grid.Column="5"
                           Text="{Binding HeaderTitle}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="15"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="6"
                           Text="AutoFit"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <views:StartView Grid.Row="1"
                         IsVisible="{Binding IsStartVisible}" />

        <Grid Grid.Row="1"
              IsVisible="{Binding IsReaderVisible}"
              ColumnDefinitions="Auto,*">
            <views:ContextShelfView Grid.Column="0"
                                    IsVisible="{Binding IsNavigationPaneVisible}" />
            <views:ReaderSurfaceView Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
