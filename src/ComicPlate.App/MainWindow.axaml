<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="800"
        x:Class="ComicPlate.App.MainWindow"
        Title="ComicPlate"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="620"
        Background="#F4F4F4"
        KeyDown="OnKeyDown"
        PointerWheelChanged="OnPointerWheelChanged">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FAFAFA" />
        <SolidColorBrush x:Key="SubtlePanelBrush" Color="#F0F0F0" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D8D8D8" />
        <SolidColorBrush x:Key="TextBrush" Color="#1F1F1F" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#666666" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    </Window.Resources>

    <Grid RowDefinitions="44,*"
          Background="#F4F4F4">
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                  Margin="10,0"
                  ColumnSpacing="8"
                  VerticalAlignment="Center">
                <Button Grid.Column="0"
                        Command="{Binding ShowStartCommand}"
                        Content="Home"
                        Padding="12,5"
                        CornerRadius="4" />
                <Button Grid.Column="1"
                        Command="{Binding OpenFolderCommand}"
                        Content="Open Folder"
                        Padding="12,5"
                        CornerRadius="4" />
                <Button Grid.Column="2"
                        Command="{Binding ToggleNavigationPaneCommand}"
                        Content="{Binding NavigationPaneToggleText}"
                        Padding="12,5"
                        CornerRadius="4"
                        IsVisible="{Binding IsReaderVisible}" />
                <Button Grid.Column="3"
                        Command="{Binding ToggleViewModeCommand}"
                        Content="{Binding ViewModeText}"
                        Padding="12,5"
                        CornerRadius="4"
                        IsVisible="{Binding IsReaderVisible}" />
                <TextBlock Grid.Column="4"
                           Text="{Binding HeaderTitle}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="15"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="5"
                           Text="AutoFit"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              IsVisible="{Binding IsStartVisible}"
              ColumnDefinitions="260,*">
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="14"
                            Spacing="10">
                    <TextBlock Text="ComicPlate"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1"
                  RowDefinitions="*,Auto,*"
                  Margin="24">
                <StackPanel Grid.Row="1"
                            Width="260"
                            HorizontalAlignment="Center"
                            Spacing="10">
                    <Button Command="{Binding OpenLastReadingPositionCommand}"
                            Content="{Binding LastReadingPositionText}"
                            HorizontalAlignment="Stretch"
                            Padding="12,9"
                            CornerRadius="4" />
                    <Button Command="{Binding OpenFolderCommand}"
                            Content="Open Comics"
                            HorizontalAlignment="Stretch"
                            Padding="12,9"
                            CornerRadius="4" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1"
              IsVisible="{Binding IsReaderVisible}"
              RowDefinitions="*,34,34"
              ColumnDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Width="300"
                    IsVisible="{Binding IsNavigationPaneVisible}"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="36,36,*">
                    <TextBlock Text="Shelf"
                               Margin="12,0"
                               Foreground="{StaticResource TextBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,1,0,1"
                            Padding="8,4">
                        <Button Command="{Binding BackCommand}"
                                Content="Back"
                                HorizontalAlignment="Left"
                                Padding="10,3"
                                CornerRadius="4" />
                    </Border>
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Shelf.Items}"
                             SelectedIndex="{Binding Shelf.CurrentIndex, Mode=TwoWay}"
                             Background="{StaticResource PanelBrush}"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="56,*"
                                      MinHeight="62"
                                      Margin="6,4">
                                    <Border Grid.Column="0"
                                            Width="48"
                                            Height="56"
                                            Background="{StaticResource SubtlePanelBrush}"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="Uniform"
                                                   IsVisible="{Binding HasThumbnail}" />
                                            <TextBlock Text="{Binding KindLabel}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding HasPlaceholder}" />
                                            <Border Background="#CC1F1F1F"
                                                    CornerRadius="3"
                                                    Padding="4,1"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Margin="3"
                                                    IsVisible="{Binding HasKindOverlay}">
                                                <TextBlock Text="{Binding KindLabel}"
                                                           Foreground="#FFFFFF"
                                                           FontSize="10" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Column="1"
                                          RowDefinitions="*,Auto"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Detail}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="1"
                    Background="#EDEDED"
                    ClipToBounds="True"
                    SizeChanged="OnReaderViewportSizeChanged"
                    PointerPressed="OnReaderPointerPressed"
                    PointerMoved="OnReaderPointerMoved"
                    PointerReleased="OnReaderPointerReleased"
                    PointerCaptureLost="OnReaderPointerCaptureLost">
                <Grid>
                    <Canvas ClipToBounds="False">
                        <ItemsControl ItemsSource="{Binding ReaderStripItems}"
                                      Canvas.Left="{Binding ReaderStripTranslateX}"
                                      Canvas.Top="0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="{Binding DisplayWidth}"
                                          Height="{Binding DisplayHeight}"
                                          Margin="8,12"
                                          Opacity="{Binding SlotOpacity}">
                                        <Border Background="#FFFFFF"
                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch">
                                            <Image Source="{Binding Image}"
                                                   Stretch="Uniform"
                                                   IsVisible="{Binding HasImage}" />
                                        </Border>
                                        <Border Background="{StaticResource PanelBrush}"
                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasMessage}">
                                            <TextBlock Text="{Binding StatusMessage}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextAlignment="Center" />
                                        </Border>
                                        <Border Background="#CCFFFFFF"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding PageLabel}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="18,14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding HasMessage}">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="15"
                                   TextAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <Button Content="Left"
                            Click="OnVisualLeftClick"
                            Padding="12,3"
                            CornerRadius="4" />
                    <Button Content="{Binding PageText}"
                            IsEnabled="False"
                            Padding="14,3"
                            CornerRadius="4" />
                    <Button Content="Right"
                            Click="OnVisualRightClick"
                            Padding="12,3"
                            CornerRadius="4" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto"
                      Margin="12,0"
                      VerticalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               Text="{Binding PageText}"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1"
                                 Margin="14,0"
                                 Minimum="0"
                                 Maximum="{Binding LastPageProgressIndex}"
                                 Value="{Binding CurrentPageProgressIndex}"
                                 Height="4"
                                 VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding CurrentLogicalPath}"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="460"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
