<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ComicPlate.App.Views.ContextShelfView">
    <UserControl.Styles>
        <Style Selector="UserControl.mac-shell Border.context-shelf-surface">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="UserControl.mac-shell ListBox.context-shelf-list">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.context-shelf-list ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="ListBox.context-shelf-list ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Grid.context-shelf-item.navigation">
            <Setter Property="Background" Value="{StaticResource ShelfNavigationHighlight}" />
        </Style>

        <Style Selector="Grid.context-shelf-item.reading">
            <Setter Property="Background" Value="{StaticResource ShelfReadingHighlight}" />
        </Style>

        <Style Selector="ListBox.context-shelf-list ListBoxItem:pointerover Grid.context-shelf-item">
            <Setter Property="Background" Value="{StaticResource ShelfHoverHighlight}" />
        </Style>

        <Style Selector="Button.pane-toggle">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button.pane-toggle.active">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Path.navi-icon">
            <Setter Property="Stroke" Value="{StaticResource TextBrush}" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>

        <Style Selector="Ellipse.navi-icon">
            <Setter Property="Stroke" Value="{StaticResource TextBrush}" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="1.8" />
        </Style>

        <Style Selector="Button:disabled Path.navi-icon">
            <Setter Property="Stroke" Value="{StaticResource DisabledTextBrush}" />
        </Style>

        <Style Selector="Button:disabled Ellipse.navi-icon">
            <Setter Property="Stroke" Value="{StaticResource DisabledTextBrush}" />
        </Style>
    </UserControl.Styles>

    <Border MinWidth="220"
            Classes="context-shelf-surface"
            Background="Transparent"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="0">
        <Grid RowDefinitions="72,*,58">
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1">
                <Grid RowDefinitions="*,Auto"
                      Margin="8,6"
                      RowSpacing="6"
                      VerticalAlignment="Center">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding ShelfTitle}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ContextShelf.ItemCount}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="6">
                        <Button Command="{Binding ShowShelfCommand}"
                                Classes="pane-toggle"
                                Classes.active="{Binding IsShelfPaneActive}"
                                ToolTip.Tip="Shelf">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="navi-icon" Data="M4.5 19V5.5 M8 18.5v-13 M11.5 18.5v-13 M15 18.5 13.4 5.8 M18.8 18.5 17.2 6.2 M3.8 19h16.4" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Command="{Binding ShowHistoryCommand}"
                                Classes="pane-toggle"
                                Classes.active="{Binding IsHistoryPaneActive}"
                                ToolTip.Tip="History">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="navi-icon" Data="M5.2 7.8a8 8 0 1 1 .1 8.5 M5.2 7.8V4.6 M5.2 7.8h3.3 M12 8.2v4.3l3 1.8" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Command="{Binding LocateCurrentBookCommand}"
                                Classes="pane-toggle"
                                ToolTip.Tip="Locate in Shelf">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Classes="navi-icon" Width="12.4" Height="12.4" Canvas.Left="5.8" Canvas.Top="5.8" />
                                    <Ellipse Classes="navi-icon" Width="4.4" Height="4.4" Canvas.Left="9.8" Canvas.Top="9.8" />
                                    <Path Classes="navi-icon" Data="M12 3.8v2.1 M12 18.1v2.1 M3.8 12h2.1 M18.1 12h2.1" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Command="{Binding NavigateUpCommand}"
                                Classes="pane-toggle"
                                ToolTip.Tip="Up One Level">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="navi-icon" Data="M4.5 19V6.8c0-.8.6-1.4 1.4-1.4h4.1l1.8 2.1h6.3c.8 0 1.4.6 1.4 1.4V19z M8.3 13.2 12 9.5l3.7 3.7 M12 9.5v6.2" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ListBox x:Name="ShelfList"
                     Grid.Row="1"
                     Classes="context-shelf-list"
                     ItemsSource="{Binding ContextShelf.Items}"
                     SelectedIndex="{Binding ContextShelf.CurrentIndex, Mode=TwoWay}"
                     Background="{StaticResource PanelBrush}"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="56,*"
                              Classes="context-shelf-item"
                              Classes.reading="{Binding IsReading}"
                              Classes.navigation="{Binding IsNavigationCurrent}"
                              MinHeight="62"
                              Margin="6,4">
                            <Border Grid.Column="0"
                                    Width="48"
                                    Height="56"
                                    Background="{StaticResource SubtlePanelBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="Uniform"
                                           IsVisible="{Binding HasThumbnail}" />
                                    <TextBlock Text="{Binding KindLabel}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding HasPlaceholder}" />
                                    <Border Background="{StaticResource OverlayDark}"
                                            CornerRadius="3"
                                            Padding="4,1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="3"
                                            IsVisible="{Binding HasKindOverlay}">
                                        <TextBlock Text="{Binding KindLabel}"
                                                   Foreground="{StaticResource TextInverse}"
                                                   FontSize="10" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Grid Grid.Column="1"
                                  RowDefinitions="*,Auto"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{StaticResource TextBrush}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Detail}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,1,0,0" />
        </Grid>
    </Border>
</UserControl>
