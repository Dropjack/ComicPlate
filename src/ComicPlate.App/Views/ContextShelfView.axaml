<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ComicPlate.App.Views.ContextShelfView">
    <Border MinWidth="220"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="0,0,1,0">
        <Grid RowDefinitions="40,*">
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto"
                      Margin="8,0"
                      ColumnSpacing="8"
                      VerticalAlignment="Center">
                <Button Command="{Binding BackCommand}"
                            Content="Back"
                            Padding="10,3"
                        CornerRadius="4" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding HeaderTitle}"
                               Foreground="{StaticResource TextBrush}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding ContextShelf.ItemCount}"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding ContextShelf.Items}"
                     SelectedIndex="{Binding ContextShelf.CurrentIndex, Mode=TwoWay}"
                     Background="{StaticResource PanelBrush}"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="56,*"
                              MinHeight="62"
                              Margin="6,4">
                            <Border Grid.Column="0"
                                    Width="48"
                                    Height="56"
                                    Background="{StaticResource SubtlePanelBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="Uniform"
                                           IsVisible="{Binding HasThumbnail}" />
                                    <TextBlock Text="{Binding KindLabel}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding HasPlaceholder}" />
                                    <Border Background="#CC1F1F1F"
                                            CornerRadius="3"
                                            Padding="4,1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="3"
                                            IsVisible="{Binding HasKindOverlay}">
                                        <TextBlock Text="{Binding KindLabel}"
                                                   Foreground="#FFFFFF"
                                                   FontSize="10" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Grid Grid.Column="1"
                                  RowDefinitions="*,Auto"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{StaticResource TextBrush}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Detail}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
