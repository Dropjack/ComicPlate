<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ComicPlate.App.Views.ReaderSurfaceView">
    <UserControl.Styles>
        <Style Selector="UserControl.mac-shell Border.reader-viewport">
            <Setter Property="Background" Value="{StaticResource ReaderStage}" />
        </Style>

        <Style Selector="UserControl.mac-shell Border.bottom-bubble">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="UserControl.mac-shell Border.reader-bottom-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,34,34">
        <Border Grid.Row="0"
                Classes="reader-viewport"
                Background="{StaticResource ReaderStage}"
                ClipToBounds="True"
                SizeChanged="OnReaderViewportSizeChanged"
                PointerPressed="OnReaderPointerPressed"
                PointerMoved="OnReaderPointerMoved"
                PointerReleased="OnReaderPointerReleased"
                PointerCaptureLost="OnReaderPointerCaptureLost">
            <Grid>
                <Canvas ClipToBounds="False">
                    <ItemsControl ItemsSource="{Binding Reader.ReaderStripItems}"
                                  Canvas.Left="{Binding Reader.ReaderStripTranslateX}"
                                  Canvas.Top="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="{Binding DisplayWidth}"
                                      Height="{Binding DisplayHeight}"
                                      Margin="8,12"
                                      Opacity="{Binding SlotOpacity}">
                                    <Border Background="{StaticResource ReaderPageSurface}"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <Image Source="{Binding Image}"
                                               Stretch="Uniform"
                                               IsVisible="{Binding HasImage}" />
                                    </Border>
                                    <Border Background="{StaticResource PanelBrush}"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding HasMessage}">
                                        <TextBlock Text="{Binding StatusMessage}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextAlignment="Center" />
                                    </Border>
                                    <Border Background="{StaticResource SurfacePanel}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Padding="6,2">
                                        <TextBlock Text="{Binding PageLabel}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="18,14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasMessage}">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="15"
                               TextAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.RowSpan="2"
                Classes="bottom-bubble"
                IsVisible="False"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="22"
                Margin="8,0,8,8" />

        <Border Grid.Row="1"
                Classes="reader-bottom-row"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <Button Click="OnVisualLeftClick"
                        Padding="12,3"
                        CornerRadius="4"
                        ToolTip.Tip="上一阅读帧">
                    <PathIcon Data="{StaticResource NavLeftIcon}"
                              Width="18"
                              Height="18" />
                </Button>
                <Button Content="{Binding Reader.PageText}"
                        IsEnabled="False"
                        Padding="14,3"
                        CornerRadius="4" />
                <Button Click="OnVisualRightClick"
                        Padding="12,3"
                        CornerRadius="4"
                        ToolTip.Tip="下一阅读帧">
                    <PathIcon Data="{StaticResource NavRightIcon}"
                              Width="18"
                              Height="18" />
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Classes="reader-bottom-row"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*"
                  Margin="12,0"
                  VerticalAlignment="Center">
                <TextBlock Grid.Column="0"
                           Text="{Binding Reader.PageText}"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center" />
                <Grid Grid.Column="1"
                      Margin="14,0"
                      Background="Transparent"
                      PointerPressed="OnProgressPointerPressed"
                      PointerReleased="OnProgressPointerReleased"
                      PointerCaptureLost="OnProgressPointerCaptureLost">
                    <ProgressBar Minimum="0"
                                 Maximum="{Binding Reader.LastPageProgressIndex}"
                                 Value="{Binding Reader.CurrentPageProgressIndex}"
                                 Height="4"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
