<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:ComicPlate.App.Localization"
        x:Class="ComicPlate.App.Views.ShortcutWindow"
        Title="{loc:Loc Shortcuts.Title}"
        Width="560"
        Height="520"
        MinWidth="460"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBase}">

    <ScrollViewer x:Name="ShortcutScrollViewer"
                  Padding="28,24"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc Shortcuts.Title}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ShortcutTextBrush}" />
                <TextBlock x:Name="ShortcutIntroText"
                           Text="{loc:Loc Shortcuts.Intro}"
                           Foreground="{StaticResource ShortcutMutedTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc Shortcuts.Group.Navigation}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ShortcutTextBrush}" />
                <Border Background="{StaticResource ShortcutCardBrush}"
                        BorderBrush="{StaticResource ShortcutBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto"
                              Margin="16,14"
                              ColumnSpacing="16">
                            <TextBlock Text="{loc:Loc Shortcuts.NextPage}"
                                       Foreground="{StaticResource ShortcutTextBrush}" />
                            <TextBlock x:Name="NextPageShortcutText"
                                       Grid.Column="1"
                                       Text="Right"
                                       Foreground="{StaticResource ShortcutMutedTextBrush}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource ShortcutBorderBrush}" />
                        <Grid ColumnDefinitions="*,Auto"
                              Margin="16,14"
                              ColumnSpacing="16">
                            <TextBlock Text="{loc:Loc Shortcuts.PreviousPage}"
                                       Foreground="{StaticResource ShortcutTextBrush}" />
                            <TextBlock x:Name="PreviousPageShortcutText"
                                       Grid.Column="1"
                                       Text="Left"
                                       Foreground="{StaticResource ShortcutMutedTextBrush}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource ShortcutBorderBrush}" />
                        <Grid ColumnDefinitions="*,Auto"
                              Margin="16,14"
                              ColumnSpacing="16">
                            <TextBlock Text="{loc:Loc Shortcuts.FirstPage}"
                                       Foreground="{StaticResource ShortcutTextBrush}" />
                            <TextBlock x:Name="FirstPageShortcutText"
                                       Grid.Column="1"
                                       Text="Home"
                                       Foreground="{StaticResource ShortcutMutedTextBrush}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource ShortcutBorderBrush}" />
                        <Grid ColumnDefinitions="*,Auto"
                              Margin="16,14"
                              ColumnSpacing="16">
                            <TextBlock Text="{loc:Loc Shortcuts.LastPage}"
                                       Foreground="{StaticResource ShortcutTextBrush}" />
                            <TextBlock x:Name="LastPageShortcutText"
                                       Grid.Column="1"
                                       Text="End"
                                       Foreground="{StaticResource ShortcutMutedTextBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc Shortcuts.Group.Actions}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ShortcutTextBrush}" />
                <Border Background="{StaticResource ShortcutCardBrush}"
                        BorderBrush="{StaticResource ShortcutBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto"
                              Margin="16,14"
                              ColumnSpacing="16">
                            <TextBlock Text="{loc:Loc Shortcuts.OpenComic}"
                                       Foreground="{StaticResource ShortcutTextBrush}" />
                            <TextBlock x:Name="OpenContentShortcutText"
                                       Grid.Column="1"
                                       Text="O"
                                       Foreground="{StaticResource ShortcutMutedTextBrush}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource ShortcutBorderBrush}" />
                        <Grid ColumnDefinitions="*,Auto"
                              Margin="16,14"
                              ColumnSpacing="16">
                            <TextBlock Text="{loc:Loc Shortcuts.ToggleShelf}"
                                       Foreground="{StaticResource ShortcutTextBrush}" />
                            <TextBlock x:Name="ToggleShelfShortcutText"
                                       Grid.Column="1"
                                       Text="Tab"
                                       Foreground="{StaticResource ShortcutMutedTextBrush}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource ShortcutBorderBrush}" />
                        <Grid ColumnDefinitions="*,Auto"
                              Margin="16,14"
                              ColumnSpacing="16">
                            <TextBlock Text="{loc:Loc Shortcuts.ToggleViewMode}"
                                       Foreground="{StaticResource ShortcutTextBrush}" />
                            <TextBlock x:Name="ToggleViewModeShortcutText"
                                       Grid.Column="1"
                                       Text="Q"
                                       Foreground="{StaticResource ShortcutMutedTextBrush}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource ShortcutBorderBrush}" />
                        <Grid ColumnDefinitions="*,Auto"
                              Margin="16,14"
                              ColumnSpacing="16">
                            <TextBlock Text="{loc:Loc Shortcuts.ToggleReadingDirection}"
                                       Foreground="{StaticResource ShortcutTextBrush}" />
                            <TextBlock x:Name="ToggleReadingDirectionShortcutText"
                                       Grid.Column="1"
                                       Text="R"
                                       Foreground="{StaticResource ShortcutMutedTextBrush}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource ShortcutBorderBrush}" />
                        <Grid ColumnDefinitions="*,Auto"
                              Margin="16,14"
                              ColumnSpacing="16">
                            <TextBlock Text="{loc:Loc Shortcuts.Fullscreen}"
                                       Foreground="{StaticResource ShortcutTextBrush}" />
                            <TextBlock x:Name="FullscreenShortcutText"
                                       Grid.Column="1"
                                       Text="F"
                                       Foreground="{StaticResource ShortcutMutedTextBrush}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource ShortcutBorderBrush}" />
                        <Grid ColumnDefinitions="*,Auto"
                              Margin="16,14"
                              ColumnSpacing="16">
                            <TextBlock Text="{loc:Loc Shortcuts.Settings}"
                                       Foreground="{StaticResource ShortcutTextBrush}" />
                            <TextBlock x:Name="SettingsShortcutText"
                                       Grid.Column="1"
                                       Text=","
                                       Foreground="{StaticResource ShortcutMutedTextBrush}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource ShortcutBorderBrush}" />
                        <Grid ColumnDefinitions="*,Auto"
                              Margin="16,14"
                              ColumnSpacing="16">
                            <TextBlock Text="{loc:Loc Shortcuts.BackToStart}"
                                       Foreground="{StaticResource ShortcutTextBrush}" />
                            <TextBlock x:Name="CloseShortcutText"
                                       Grid.Column="1"
                                       Text="W"
                                       Foreground="{StaticResource ShortcutMutedTextBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border x:Name="BottomScrollSpacer"
                    Height="0"
                    Background="Transparent" />
        </StackPanel>
    </ScrollViewer>
</Window>
