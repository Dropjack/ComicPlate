<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ComicPlate.App.Views.StartView">
    <Grid RowDefinitions="*,Auto,*"
          Background="{StaticResource BackgroundBase}"
          Margin="24">
        <StackPanel Grid.Row="1"
                    Width="300"
                    HorizontalAlignment="Center"
                    Spacing="12">
            <TextBlock Text="ComicPlate"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12" />
            <Button Command="{Binding OpenLastReadingPositionCommand}"
                    Content="{Binding LastReadingPositionText}"
                    HorizontalAlignment="Stretch"
                    Padding="12,10"
                    CornerRadius="6" />
            <Button Command="{Binding OpenContentCommand}"
                    Content="Open Comics"
                    HorizontalAlignment="Stretch"
                    Padding="12,10"
                    CornerRadius="6" />
        </StackPanel>
    </Grid>
</UserControl>
