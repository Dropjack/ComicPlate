<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ComicPlate.App.Views.SettingsWindow"
        Title="设置"
        Icon="/platform/windows/ComicPlate.ico"
        Width="840"
        Height="620"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBase}">
    <Window.Styles>
        <Style Selector="Window.mac-shell">
            <Setter Property="Background" Value="{StaticResource BackgroundBase}" />
        </Style>

        <Style Selector="Window.mac-shell Grid.settings-root">
            <Setter Property="Background" Value="{StaticResource SettingsContentBrush}" />
        </Style>

        <Style Selector="Window.mac-shell Border.settings-nav-panel">
            <Setter Property="Background" Value="{StaticResource SettingsNavBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsBorderBrush}" />
        </Style>

        <Style Selector="Window.mac-shell Border.settings-card">
            <Setter Property="Background" Value="{StaticResource SettingsCardBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style Selector="Button.settings-nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
        </Style>

        <Style Selector="Button.settings-nav.selected">
            <Setter Property="Background" Value="{StaticResource SettingsSelectedBrush}" />
        </Style>

        <Style Selector="Window.mac-shell Button.settings-nav.selected">
            <Setter Property="Background" Value="{StaticResource SettingsSelectedBrush}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Window.Styles>

    <Grid x:Name="SettingsRootGrid"
          ColumnDefinitions="220,*"
          Classes="settings-root"
          Background="{StaticResource SettingsContentBrush}">
        <Border Grid.Column="0"
                Classes="settings-nav-panel"
                Background="{StaticResource SettingsNavBrush}"
                BorderBrush="{StaticResource SettingsBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*"
                  Margin="18,18,12,18">
                <TextBlock Text="设置"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SettingsTextBrush}"
                           Margin="0,0,0,20" />

                <StackPanel Grid.Row="1"
                            Spacing="4">
                    <Button x:Name="StartupNavButton"
                            Classes="settings-nav selected"
                            Content="启动与窗口"
                            Click="OnStartupNavClick" />
                    <Button x:Name="AppearanceNavButton"
                            Classes="settings-nav"
                            Content="外观"
                            Click="OnAppearanceNavClick" />
                    <Button x:Name="DataNavButton"
                            Classes="settings-nav"
                            Content="数据与缓存"
                            Click="OnDataNavClick" />
                    <Button x:Name="AssociationNavButton"
                            Classes="settings-nav"
                            Content="文件关联"
                            Click="OnAssociationNavClick" />
                    <Button x:Name="ShortcutsNavButton"
                            Classes="settings-nav"
                            Content="快捷键"
                            Click="OnShortcutsNavClick" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="ContentScrollViewer"
                      Grid.Column="1"
                      Padding="28,24"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentStack"
                        Spacing="24"
                        HorizontalAlignment="Stretch">
                <TextBlock Text="ComicPlate 设置"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SettingsTextBrush}" />

                <StackPanel x:Name="StartupSection"
                            Spacing="10">
                    <TextBlock Text="启动与窗口"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsTextBrush}" />
                    <Border Classes="settings-card"
                            Background="{StaticResource SettingsCardBrush}"
                            BorderBrush="{StaticResource SettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel>
                            <Grid x:Name="MultiWindowRow"
                                  ColumnDefinitions="*,Auto"
                                  Margin="16,14"
                                  ColumnSpacing="16">
                                <StackPanel Spacing="3"
                                            MinWidth="0">
                                    <TextBlock Text="允许多开窗口"
                                               Foreground="{StaticResource SettingsTextBrush}"
                                               FontSize="15" />
                                    <TextBlock Text="允许同时打开多个 ComicPlate 窗口。"
                                               Foreground="{StaticResource SettingsMutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="MultiWindowToggle"
                                              Grid.Column="1"
                                              Click="OnSettingToggleClick"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="1"
                                    Background="{StaticResource SettingsBorderBrush}" />
                            <Grid x:Name="RestoreWindowRow"
                                  ColumnDefinitions="*,Auto"
                                  Margin="16,14"
                                  ColumnSpacing="16">
                                <StackPanel Spacing="3"
                                            MinWidth="0">
                                    <TextBlock Text="恢复窗口大小和位置"
                                               Foreground="{StaticResource SettingsTextBrush}"
                                               FontSize="15" />
                                    <TextBlock Text="下次启动时恢复上次关闭时的窗口大小和位置。"
                                               Foreground="{StaticResource SettingsMutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="RestoreWindowToggle"
                                              Grid.Column="1"
                                              Click="OnSettingToggleClick"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="AppearanceSection"
                            Spacing="10">
                    <TextBlock Text="外观"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsTextBrush}" />
                    <Border Classes="settings-card"
                            Background="{StaticResource SettingsCardBrush}"
                            BorderBrush="{StaticResource SettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid x:Name="PaletteRow"
                              ColumnDefinitions="*,Auto"
                              Margin="16,14"
                              ColumnSpacing="16">
                            <StackPanel Spacing="3"
                                        MinWidth="0">
                                <TextBlock Text="配色方案"
                                           Foreground="{StaticResource SettingsTextBrush}"
                                           FontSize="15" />
                                <TextBlock Text="影响左侧命令栏、Context Shelf、阅读区域、书名条和进度区。具体方案在 UI polish 阶段确定。"
                                           Foreground="{StaticResource SettingsMutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      IsEnabled="False"
                                      SelectedIndex="0"
                                      Width="180"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="默认浅灰" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DataSection"
                            Spacing="10">
                    <TextBlock Text="数据与缓存"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsTextBrush}" />
                    <Border Classes="settings-card"
                            Background="{StaticResource SettingsCardBrush}"
                            BorderBrush="{StaticResource SettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel>
                            <Grid x:Name="DataFolderRow"
                                  ColumnDefinitions="*,Auto"
                                  Margin="16,14"
                                  ColumnSpacing="16">
                                <StackPanel Spacing="3"
                                            MinWidth="0">
                                    <TextBlock Text="数据目录"
                                               Foreground="{StaticResource SettingsTextBrush}"
                                               FontSize="15" />
                                    <TextBlock Text="保存本机设置、阅读进度与缓存。"
                                               Foreground="{StaticResource SettingsMutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="DataFolderOpenButton"
                                        Grid.Column="1"
                                        Content="打开"
                                        Width="86"
                                        Click="OnOpenDataFolderClick"
                                        VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="1"
                                    Background="{StaticResource SettingsBorderBrush}" />
                            <Grid x:Name="ThumbnailCacheRow"
                                  ColumnDefinitions="*,Auto"
                                  Margin="16,14"
                                  ColumnSpacing="16">
                                <StackPanel Spacing="3"
                                            MinWidth="0">
                                    <TextBlock Text="缩略图缓存"
                                               Foreground="{StaticResource SettingsTextBrush}"
                                               FontSize="15" />
                                    <TextBlock Text="清理可重建的封面缩略图。"
                                               Foreground="{StaticResource SettingsMutedTextBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="ThumbnailCacheStatusText"
                                               Foreground="{StaticResource SettingsMutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="ThumbnailCacheClearButton"
                                        Grid.Column="1"
                                        Content="清理"
                                        Width="86"
                                        Click="OnClearThumbnailCacheClick"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="AssociationSection"
                            Spacing="10">
                    <TextBlock Text="文件关联"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsTextBrush}" />
                    <Border Classes="settings-card"
                            Background="{StaticResource SettingsCardBrush}"
                            BorderBrush="{StaticResource SettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel Margin="16,14"
                                    Spacing="12">
                            <TextBlock Text="这些关联不会自动启用。只有勾选后才会修改系统默认打开方式。"
                                       Foreground="{StaticResource SettingsMutedTextBrush}"
                                       TextWrapping="Wrap" />
                            <UniformGrid x:Name="AssociationOptionsGrid"
                                         Columns="2">
                                <CheckBox x:Name="CbzAssociationCheckBox"
                                          Content="CBZ"
                                          Tag=".cbz"
                                          Click="OnAssociateFileClick" />
                                <CheckBox x:Name="CbrAssociationCheckBox"
                                          Content="CBR"
                                          Tag=".cbr"
                                          Click="OnAssociateFileClick" />
                            </UniformGrid>
                            <TextBlock x:Name="AssociationStatusText"
                                       Foreground="{StaticResource SettingsMutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ExplorerContextMenuSection"
                            Spacing="10">
                    <TextBlock Text="资源管理器右键菜单"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsTextBrush}" />
                    <Border Classes="settings-card"
                            Background="{StaticResource SettingsCardBrush}"
                            BorderBrush="{StaticResource SettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel Margin="16,14"
                                    Spacing="12">
                            <TextBlock Text="将“在 ComicPlate 中打开”添加到资源管理器上下文菜单"
                                       Foreground="{StaticResource SettingsMutedTextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="在右键菜单中显示“在 ComicPlate 中打开”"
                                       Foreground="{StaticResource SettingsMutedTextBrush}"
                                       TextWrapping="Wrap" />
                            <UniformGrid x:Name="ExplorerContextMenuOptionsGrid"
                                         Columns="2">
                                <CheckBox x:Name="ExplorerContextMenuCbzCheckBox"
                                          Content="CBZ"
                                          Tag=".cbz"
                                          Click="OnExplorerContextMenuClick" />
                                <CheckBox x:Name="ExplorerContextMenuCbrCheckBox"
                                          Content="CBR"
                                          Tag=".cbr"
                                          Click="OnExplorerContextMenuClick" />
                                <CheckBox x:Name="ExplorerContextMenuZipCheckBox"
                                          Content="ZIP"
                                          Tag=".zip"
                                          Click="OnExplorerContextMenuClick" />
                                <CheckBox x:Name="ExplorerContextMenuRarCheckBox"
                                          Content="RAR"
                                          Tag=".rar"
                                          Click="OnExplorerContextMenuClick" />
                            </UniformGrid>
                            <TextBlock x:Name="ExplorerContextMenuStatusText"
                                       Foreground="{StaticResource SettingsMutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ShortcutsSection"
                            Spacing="10">
                    <TextBlock Text="快捷键"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsTextBrush}" />
                    <Border Classes="settings-card"
                            Background="{StaticResource SettingsCardBrush}"
                            BorderBrush="{StaticResource SettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid x:Name="ShortcutsRow"
                              ColumnDefinitions="*,Auto"
                              Margin="16,14"
                              ColumnSpacing="16">
                            <StackPanel Spacing="3"
                                        MinWidth="0">
                                <TextBlock Text="快捷键列表"
                                           Foreground="{StaticResource SettingsTextBrush}"
                                           FontSize="15" />
                                <TextBlock Text="快捷键会使用独立窗口显示。当前阶段先保留入口，不做编辑。"
                                           Foreground="{StaticResource SettingsMutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="打开"
                                    Width="86"
                                    Click="OnOpenShortcutsClick"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Border x:Name="BottomScrollSpacer"
                        Height="360"
                        Background="Transparent" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
