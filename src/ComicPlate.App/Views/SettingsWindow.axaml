<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:ComicPlate.App.Localization"
        x:Class="ComicPlate.App.Views.SettingsWindow"
        Title="{loc:Loc Settings.Title}"
        Width="840"
        Height="620"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBase}">
    <Window.Styles>
        <Style Selector="Window.mac-shell">
            <Setter Property="Background" Value="{StaticResource BackgroundBase}" />
        </Style>

        <Style Selector="Window.mac-shell Grid.settings-root">
            <Setter Property="Background" Value="{StaticResource SettingsContentBrush}" />
        </Style>

        <Style Selector="Window.mac-shell Border.settings-nav-panel">
            <Setter Property="Background" Value="{StaticResource SettingsNavBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsBorderBrush}" />
        </Style>

        <Style Selector="Window.mac-shell Border.settings-card">
            <Setter Property="Background" Value="{StaticResource SettingsCardBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style Selector="Button.settings-nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
        </Style>

        <Style Selector="Button.settings-nav.selected">
            <Setter Property="Background" Value="{StaticResource SettingsSelectedBrush}" />
        </Style>

        <Style Selector="Window.mac-shell Button.settings-nav.selected">
            <Setter Property="Background" Value="{StaticResource SettingsSelectedBrush}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Window.Styles>

    <Grid x:Name="SettingsRootGrid"
          ColumnDefinitions="220,*"
          Classes="settings-root"
          Background="{StaticResource SettingsContentBrush}">
        <Border Grid.Column="0"
                Classes="settings-nav-panel"
                Background="{StaticResource SettingsNavBrush}"
                BorderBrush="{StaticResource SettingsBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*"
                  Margin="18,18,12,18">
                <TextBlock Text="{loc:Loc Settings.Title}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SettingsTextBrush}"
                           Margin="0,0,0,20" />

                <StackPanel Grid.Row="1"
                            Spacing="4">
                    <Button x:Name="StartupNavButton"
                            Classes="settings-nav selected"
                            Content="{loc:Loc Settings.StartupAndWindow}"
                            Click="OnStartupNavClick" />
                    <Button x:Name="AppearanceNavButton"
                            Classes="settings-nav"
                            Content="{loc:Loc Settings.Appearance}"
                            Click="OnAppearanceNavClick" />
                    <Button x:Name="ReadingNavButton"
                            Classes="settings-nav"
                            Content="{loc:Loc Settings.Reading}"
                            Click="OnReadingNavClick" />
                    <Button x:Name="DataNavButton"
                            Classes="settings-nav"
                            Content="{loc:Loc Settings.DataAndCache}"
                            Click="OnDataNavClick" />
                    <Button x:Name="AssociationNavButton"
                            Classes="settings-nav"
                            Content="{loc:Loc Settings.FileAssociations}"
                            Click="OnAssociationNavClick" />
                    <Button x:Name="ShortcutsNavButton"
                            Classes="settings-nav"
                            Content="{loc:Loc Settings.Shortcuts}"
                            Click="OnShortcutsNavClick" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="ContentScrollViewer"
                      Grid.Column="1"
                      Padding="28,24"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentStack"
                        Spacing="24"
                        HorizontalAlignment="Stretch">
                <TextBlock Text="{loc:Loc Settings.Header}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SettingsTextBrush}" />

                <StackPanel x:Name="StartupSection"
                            Spacing="10">
                    <TextBlock Text="{loc:Loc Settings.StartupAndWindow}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsTextBrush}" />
                    <Border Classes="settings-card"
                            Background="{StaticResource SettingsCardBrush}"
                            BorderBrush="{StaticResource SettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel>
                            <Grid x:Name="MultiWindowRow"
                                  ColumnDefinitions="*,Auto"
                                  Margin="16,14"
                                  ColumnSpacing="16">
                                <StackPanel Spacing="3"
                                            MinWidth="0">
                                    <TextBlock Text="{loc:Loc Settings.AllowMultipleWindows.Label}"
                                               Foreground="{StaticResource SettingsTextBrush}"
                                               FontSize="15" />
                                    <TextBlock Text="{loc:Loc Settings.AllowMultipleWindows.Description}"
                                               Foreground="{StaticResource SettingsMutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="MultiWindowToggle"
                                              Grid.Column="1"
                                              Click="OnSettingToggleClick"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="1"
                                    Background="{StaticResource SettingsBorderBrush}" />
                            <Grid x:Name="RestoreWindowRow"
                                  ColumnDefinitions="*,Auto"
                                  Margin="16,14"
                                  ColumnSpacing="16">
                                <StackPanel Spacing="3"
                                            MinWidth="0">
                                    <TextBlock Text="{loc:Loc Settings.RestoreWindowPlacement.Label}"
                                               Foreground="{StaticResource SettingsTextBrush}"
                                               FontSize="15" />
                                    <TextBlock Text="{loc:Loc Settings.RestoreWindowPlacement.Description}"
                                               Foreground="{StaticResource SettingsMutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="RestoreWindowToggle"
                                              Grid.Column="1"
                                              Click="OnSettingToggleClick"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="AppearanceSection"
                            Spacing="10">
                    <TextBlock Text="{loc:Loc Settings.Appearance}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsTextBrush}" />
                    <Border Classes="settings-card"
                            Background="{StaticResource SettingsCardBrush}"
                            BorderBrush="{StaticResource SettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel>
                            <Grid x:Name="PaletteRow"
                                  ColumnDefinitions="*,Auto"
                                  Margin="16,14"
                                  ColumnSpacing="16">
                                <StackPanel Spacing="3"
                                            MinWidth="0">
                                    <TextBlock Text="{loc:Loc Settings.Theme.Label}"
                                               Foreground="{StaticResource SettingsTextBrush}"
                                               FontSize="15" />
                                    <TextBlock Text="{loc:Loc Settings.Theme.Description}"
                                               Foreground="{StaticResource SettingsMutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="ColorThemeComboBox"
                                          Grid.Column="1"
                                          Width="180"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="{loc:Loc Settings.Theme.MistGreen}" />
                                    <ComboBoxItem Content="{loc:Loc Settings.Theme.SlateBlue}" />
                                    <ComboBoxItem Content="{loc:Loc Settings.Theme.WarmPaper}" />
                                    <ComboBoxItem Content="{loc:Loc Settings.Theme.NightGraphite}" />
                                </ComboBox>
                            </Grid>
                            <Border Height="1"
                                    Background="{StaticResource SettingsBorderBrush}" />
                            <Grid x:Name="LanguageRow"
                                  ColumnDefinitions="*,Auto"
                                  Margin="16,14"
                                  ColumnSpacing="16">
                                <StackPanel Spacing="3"
                                            MinWidth="0">
                                    <TextBlock x:Name="LanguageLabelText"
                                               Foreground="{StaticResource SettingsTextBrush}"
                                               FontSize="15" />
                                    <TextBlock x:Name="LanguageDescriptionText"
                                               Foreground="{StaticResource SettingsMutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="LanguageComboBox"
                                          Grid.Column="1"
                                          Width="180"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem />
                                    <ComboBoxItem />
                                    <ComboBoxItem />
                                    <ComboBoxItem />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ReadingSection"
                            Spacing="10">
                    <TextBlock Text="{loc:Loc Settings.Reading}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsTextBrush}" />
                    <Border Classes="settings-card"
                            Background="{StaticResource SettingsCardBrush}"
                            BorderBrush="{StaticResource SettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid x:Name="MagnifierRow"
                              ColumnDefinitions="*,Auto"
                              Margin="16,14"
                              ColumnSpacing="16">
                            <StackPanel Spacing="3"
                                        MinWidth="0">
                                <TextBlock Text="{loc:Loc Settings.Magnifier.Label}"
                                           Foreground="{StaticResource SettingsTextBrush}"
                                           FontSize="15" />
                                <TextBlock Text="{loc:Loc Settings.Magnifier.Description}"
                                           Foreground="{StaticResource SettingsMutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Loc Settings.Magnifier.ShortcutHint}"
                                           Foreground="{StaticResource SettingsMutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="MagnifierToggle"
                                          Grid.Column="1"
                                          Click="OnSettingToggleClick"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DataSection"
                            Spacing="10">
                    <TextBlock Text="{loc:Loc Settings.DataAndCache}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsTextBrush}" />
                    <Border Classes="settings-card"
                            Background="{StaticResource SettingsCardBrush}"
                            BorderBrush="{StaticResource SettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel>
                            <Grid x:Name="DataFolderRow"
                                  ColumnDefinitions="*,Auto"
                                  Margin="16,14"
                                  ColumnSpacing="16">
                                <StackPanel Spacing="3"
                                            MinWidth="0">
                                    <TextBlock Text="{loc:Loc Settings.DataFolder.Label}"
                                               Foreground="{StaticResource SettingsTextBrush}"
                                               FontSize="15" />
                                    <TextBlock Text="{loc:Loc Settings.DataFolder.Description}"
                                               Foreground="{StaticResource SettingsMutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="DataFolderOpenButton"
                                        Grid.Column="1"
                                        Content="{loc:Loc Common.Open}"
                                        Width="86"
                                        Click="OnOpenDataFolderClick"
                                        VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="1"
                                    Background="{StaticResource SettingsBorderBrush}" />
                            <Grid x:Name="ThumbnailCacheRow"
                                  ColumnDefinitions="*,Auto"
                                  Margin="16,14"
                                  ColumnSpacing="16">
                                <StackPanel Spacing="3"
                                            MinWidth="0">
                                    <TextBlock Text="{loc:Loc Settings.ThumbnailCache.Label}"
                                               Foreground="{StaticResource SettingsTextBrush}"
                                               FontSize="15" />
                                    <TextBlock Text="{loc:Loc Settings.ThumbnailCache.Description}"
                                               Foreground="{StaticResource SettingsMutedTextBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="ThumbnailCacheStatusText"
                                               Foreground="{StaticResource SettingsMutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="ThumbnailCacheClearButton"
                                        Grid.Column="1"
                                        Content="{loc:Loc Common.Clear}"
                                        Width="86"
                                        Click="OnClearThumbnailCacheClick"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="AssociationSection"
                            Spacing="10">
                    <TextBlock Text="{loc:Loc Settings.FileAssociations}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsTextBrush}" />
                    <Border Classes="settings-card"
                            Background="{StaticResource SettingsCardBrush}"
                            BorderBrush="{StaticResource SettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel Margin="16,14"
                                    Spacing="12">
                            <TextBlock Text="{loc:Loc Settings.FileAssociations.Description}"
                                       Foreground="{StaticResource SettingsMutedTextBrush}"
                                       TextWrapping="Wrap" />
                            <UniformGrid x:Name="AssociationOptionsGrid"
                                         Columns="2">
                                <CheckBox x:Name="CbzAssociationCheckBox"
                                          Content="CBZ"
                                          Tag=".cbz"
                                          Click="OnAssociateFileClick" />
                                <CheckBox x:Name="CbrAssociationCheckBox"
                                          Content="CBR"
                                          Tag=".cbr"
                                          Click="OnAssociateFileClick" />
                            </UniformGrid>
                            <TextBlock x:Name="AssociationStatusText"
                                       Foreground="{StaticResource SettingsMutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ExplorerContextMenuSection"
                            Spacing="10">
                    <TextBlock Text="{loc:Loc Settings.ExplorerContextMenu.Title}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsTextBrush}" />
                    <Border Classes="settings-card"
                            Background="{StaticResource SettingsCardBrush}"
                            BorderBrush="{StaticResource SettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel Margin="16,14"
                                    Spacing="12">
                            <TextBlock Text="{loc:Loc Settings.ExplorerContextMenu.Description}"
                                       Foreground="{StaticResource SettingsMutedTextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{loc:Loc Settings.ExplorerContextMenu.OptionDescription}"
                                       Foreground="{StaticResource SettingsMutedTextBrush}"
                                       TextWrapping="Wrap" />
                            <UniformGrid x:Name="ExplorerContextMenuOptionsGrid"
                                         Columns="2">
                                <CheckBox x:Name="ExplorerContextMenuCbzCheckBox"
                                          Content="CBZ"
                                          Tag=".cbz"
                                          Click="OnExplorerContextMenuClick" />
                                <CheckBox x:Name="ExplorerContextMenuCbrCheckBox"
                                          Content="CBR"
                                          Tag=".cbr"
                                          Click="OnExplorerContextMenuClick" />
                                <CheckBox x:Name="ExplorerContextMenuZipCheckBox"
                                          Content="ZIP"
                                          Tag=".zip"
                                          Click="OnExplorerContextMenuClick" />
                                <CheckBox x:Name="ExplorerContextMenuRarCheckBox"
                                          Content="RAR"
                                          Tag=".rar"
                                          Click="OnExplorerContextMenuClick" />
                                <CheckBox x:Name="ExplorerContextMenuPdfCheckBox"
                                          Content="PDF"
                                          Tag=".pdf"
                                          Click="OnExplorerContextMenuClick" />
                            </UniformGrid>
                            <TextBlock x:Name="ExplorerContextMenuStatusText"
                                       Foreground="{StaticResource SettingsMutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ShortcutsSection"
                            Spacing="10">
                    <TextBlock Text="{loc:Loc Settings.Shortcuts}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsTextBrush}" />
                    <Border Classes="settings-card"
                            Background="{StaticResource SettingsCardBrush}"
                            BorderBrush="{StaticResource SettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid x:Name="ShortcutsRow"
                              ColumnDefinitions="*,Auto"
                              Margin="16,14"
                              ColumnSpacing="16">
                            <StackPanel Spacing="3"
                                        MinWidth="0">
                                <TextBlock Text="{loc:Loc Settings.Shortcuts.Label}"
                                           Foreground="{StaticResource SettingsTextBrush}"
                                           FontSize="15" />
                                <TextBlock Text="{loc:Loc Settings.Shortcuts.Description}"
                                           Foreground="{StaticResource SettingsMutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{loc:Loc Common.Open}"
                                    Width="86"
                                    Click="OnOpenShortcutsClick"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Border x:Name="BottomScrollSpacer"
                        Height="360"
                        Background="Transparent" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
