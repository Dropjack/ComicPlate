<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ComicPlate.App.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ComicPlate.App/Themes/ColorTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="TextBlock:disabled">
            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button:disabled PathIcon">
            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="ComboBox:disabled">
            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="CheckBox:disabled">
            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Application.Styles>
</Application>
